# =============================================================================
# LOCKON Workspace — Environment Configuration Template
# =============================================================================
# Copy this file to .env and update all values marked with <CHANGE_ME>
# NEVER commit the .env file to version control.
# =============================================================================

# Domain of service (change for production, e.g. workspace.lockon.io)
DOMAIN=localhost

# Container settings
## Timezone: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Asia/Bangkok
RESTART_POLICY=unless-stopped

# =============================================================================
# PostgreSQL Settings
# =============================================================================
POSTGRES_IMAGE_TAG=18-alpine
POSTGRES_DATA_PATH=./volumes/db/var/lib/postgresql/data

POSTGRES_USER=mmuser
## IMPORTANT: Generate a strong password before deploying!
## PowerShell:  [System.Convert]::ToBase64String((1..24 | % { Get-Random -Max 256 }) -as [byte[]]).Substring(0,32)
## Linux/macOS: openssl rand -base64 32 | head -c 32
POSTGRES_PASSWORD=<CHANGE_ME_GENERATE_STRONG_PASSWORD>
POSTGRES_DB=mattermost

# =============================================================================
# Nginx (used only with docker-compose.nginx.yml overlay)
# =============================================================================
NGINX_IMAGE_TAG=alpine
NGINX_CONFIG_PATH=./nginx/conf.d
NGINX_DHPARAMS_FILE=./nginx/dhparams4096.pem

CERT_PATH=./volumes/web/cert/cert.pem
KEY_PATH=./volumes/web/cert/key-no-password.pem

## Exposed ports
# The port Mattermost Calls will use. Note: 8443 is often reserved by Hyper-V on Windows. 8543 is safer.
HTTPS_PORT=443
HTTP_PORT=80
CALLS_PORT=8543

# =============================================================================
# Mattermost Settings
# =============================================================================
MATTERMOST_CONFIG_PATH=./volumes/app/mattermost/config
MATTERMOST_DATA_PATH=./volumes/app/mattermost/data
MATTERMOST_LOGS_PATH=./volumes/app/mattermost/logs
MATTERMOST_PLUGINS_PATH=./volumes/app/mattermost/plugins
MATTERMOST_CLIENT_PLUGINS_PATH=./volumes/app/mattermost/client/plugins
MATTERMOST_BLEVE_INDEXES_PATH=./volumes/app/mattermost/bleve-indexes

## Bleve index (inside the container)
MM_BLEVESETTINGS_INDEXDIR=/mattermost/bleve-indexes

## LOCKON uses Team Edition (MIT license, fully open-source)
MATTERMOST_IMAGE=mattermost-team-edition
MATTERMOST_IMAGE_TAG=11.7.0

MATTERMOST_CONTAINER_READONLY=false

## App port (used with docker-compose.without-nginx.yml)
APP_PORT=8065

## Mattermost configuration overrides
MM_SQLSETTINGS_DRIVERNAME=postgres
MM_SQLSETTINGS_DATASOURCE=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable&connect_timeout=10

## For development (without nginx): http://${DOMAIN}:8065
## For production (with nginx):     https://${DOMAIN}
MM_SERVICESETTINGS_SITEURL=http://${DOMAIN}:8065

## Log level: DEBUG for development, INFO for production
MM_LOGSETTINGS_CONSOLELEVEL=INFO

# =============================================================================
# Monitoring (used with docker-compose.production.yml overlay)
# =============================================================================
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
## IMPORTANT: Generate a strong password before deploying!
GRAFANA_ADMIN_PASSWORD=<CHANGE_ME_GENERATE_STRONG_PASSWORD>
